# ── AgroWare Environment Variables ──────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# OpenCage Geocoding API
# Get it at: https://opencagedata.com/api
OPENCAGE_API_KEY=

# ── OPTIONAL (fallback only) ──────────────────────────────────────────────────

# OpenWeather API — only used if NASA POWER is unavailable
# Get it at: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# ── RECOMMENDED (for real P and K soil values) ────────────────────────────────

# data.gov.in — Indian Soil Health Card dataset
# Register at: https://data.gov.in/user/register
# Then request access to the Soil Health Card dataset
DATA_GOV_IN_API_KEY=

# ── NO KEY NEEDED ─────────────────────────────────────────────────────────────
# NASA POWER  : https://power.larc.nasa.gov  — free, no registration
# SoilGrids   : https://rest.isric.org       — free, no registration